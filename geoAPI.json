    {
      "name": "📏 Distance",
      "item": [
        {
          "name": "Calculer une distance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?action=calculatedistance&lat1=48.8566&lng1=2.3522&lat2=47.2173&lng2=-1.5536",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "calculatedistance"
                },
                {
                  "key": "lat1",
                  "value": "48.8566",
                  "description": "Latitude point 1 (Paris)"
                },
                {
                  "key": "lng1",
                  "value": "2.3522",
                  "description": "Longitude point 1"
                },
                {
                  "key": "lat2",
                  "value": "47.2173",
                  "description": "Latitude point 2 (Nantes)"
                },
                {
                  "key": "lng2",
                  "value": "-1.5536",
                  "description": "Longitude point 2"
                }
              ]
            },
            "description": "Calcule la distance entre deux points GPS (formule de Haversine).\n\n**Exemple:** Distance Paris → Nantes"
          },
          "response": []
        },
        {
          "name": "Calculer plusieurs distances",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?action=calculatedistances&originLat=48.8566&originLng=2.3522&destinations=[{\"lat\":45.7640,\"lng\":4.8357,\"name\":\"Lyon\"},{\"lat\":43.2965,\"lng\":5.3698,\"name\":\"Marseille\"},{\"lat\":44.8378,\"lng\":-0.5792,\"name\":\"Bordeaux\"}]",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "action",
                  "value": "calculatedistances"
                },
                {
                  "key": "originLat",
                  "value": "48.8566",
                  "description": "Latitude origine (Paris)"
                },
                {
                  "key": "originLng",
