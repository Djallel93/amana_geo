			"item": [
				{
					"name": "Géocoder une adresse",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}?action=geocode&adresse=10 rue de Rivoli&ville=Paris&codePostal=75001&X-Api-Key={{apiKey}}",
							"host": [
								"{{baseUrl}}"
							],
							"query": [
								{
									"key": "action",
									"value": "geocode"
								},
								{
									"key": "adresse",
									"value": "10 rue de Rivoli"
								},
								{
									"key": "ville",
									"value": "Paris"
								},
								{
									"key": "codePostal",
									"value": "75001"
								},
								{
									"key": "X-Api-Key",
									"value": "{{apiKey}}"
								}
							]
						},
						"description": "Convertit une adresse en coordonnées GPS via Google Maps Geocoding API."
					},
					"response": []
				},
