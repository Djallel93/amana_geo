model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["quartiers","secteurs","villes"]

annotation PBI_ProTooling = ["DevMode"]

ref table quartiers
ref table secteurs
ref table villes

ref cultureInfo en-GB

