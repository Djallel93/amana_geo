model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Quartier","Secteur","Ville"]

annotation PBI_ProTooling = ["DevMode"]

ref table Quartier
ref table Secteur
ref table Ville

ref cultureInfo en-GB

